# RabbitMQ
RABBITMQ_URL=amqp://dev:dev@localhost:5672/%2f

# Backend callback base url
BACKEND_BASE_URL=http://localhost:9000

# Global timing & failure injection
MOCK_GENERATING_DELAY_MS=500
MOCK_FINISHED_DELAY_MS=3000
MOCK_FAILURE_RATE=0.0
MOCK_PREFETCH=16

# Object keys (within zhiying-content bucket) returned in FINISHED payloads.
# 前端通过 /api/v1/config 暴露的 storage.public_base + bucket 拼出可访问 URL。
MOCK_VIDEO_OBJECT_KEY=knowledge-videos/mock-placeholder.mp4
MOCK_CODE_VIDEO_OBJECT_KEY=code-videos/mock-placeholder.mp4
MOCK_HTML_OBJECT_KEY=interactive-html/mock-placeholder/index.html

# Mock generation sizes
MOCK_PRETEST_PROBLEM_COUNT=10
MOCK_QUIZ_PROBLEM_COUNT=5
MOCK_PLAN_TASKS_PER_STAGE=3

# API keys (must match zhiying-backend/.env.example)
KNOWLEDGE_VIDEO_API_KEY=sk-knowledge-video-dev
CODE_VIDEO_API_KEY=sk-code-video-dev
INTERACTIVE_HTML_API_KEY=sk-interactive-html-dev
KNOWLEDGE_EXPLANATION_API_KEY=sk-knowledge-explanation-dev
PRETEST_API_KEY=sk-pretest-dev
PLAN_API_KEY=sk-plan-dev
QUIZ_API_KEY=sk-quiz-dev

# Per-service overrides (optional). Naming: MOCK_<SERVICE>_GENERATING_DELAY_MS, etc.
# Example:
# MOCK_PRETEST_FINISHED_DELAY_MS=8000
# MOCK_PLAN_FAILURE_RATE=1.0
