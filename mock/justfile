session := "zhiying-mocks"
health_url := "http://localhost:9200/health"

# Spawn uv run zhiying-mocks in tmux, block on /health.
serve:
  @tmux has-session -t {{session}} 2>/dev/null || tmux new -d -s {{session}} 'uv run zhiying-mocks'
  @just wait

# Block until /health responds 200, or fail after 60s.
wait:
  @timeout 60 bash -c 'until curl -sf {{health_url}} >/dev/null 2>&1; do sleep 0.5; done' \
    && printf '\033[32m✔\033[0m zhiying-mocks \033[32mReady\033[0m\n' \
    || (printf '\033[31m✗\033[0m zhiying-mocks \033[31mFailed\033[0m\n'; exit 1)

# Kill the tmux session running uv run zhiying-mocks.
stop:
  @if tmux has-session -t {{session}} 2>/dev/null; then \
     tmux kill-session -t {{session}}; \
     printf '\033[32m✔\033[0m zhiying-mocks \033[32mStopped\033[0m\n'; \
   fi

log:
  @tmux attach -t {{session}}

lint:
  uv run ruff check src

fmt:
  uv run ruff format src

# Remove Python and tooling caches.
clean:
  @find src -type d \( -name __pycache__ -o -name .ruff_cache -o -name .mypy_cache \) -exec rm -rf {} + \
    && rm -rf .ruff_cache .mypy_cache .pytest_cache \
    && printf '\033[32m✔\033[0m zhiying-mocks \033[32mCleaned\033[0m\n'
