# ============================================================================
# Knowledge2Video 环境变量配置
# 
# 使用方法：复制此文件为 .env，然后修改对应的值
#   cp .env.example .env
# ============================================================================

# --------------------------------------------------------------------------
# API 认证密钥（前端调用时需要在请求头中携带）
# 多个密钥用逗号分隔
# --------------------------------------------------------------------------
API_KEYS=

# --------------------------------------------------------------------------
# 默认 LLM API（当前统一使用 GPT）
# --------------------------------------------------------------------------
DEFAULT_API=gpt-5

# OpenAI 兼容 LLM 网关
DMX_BASE_URL=https://api.example.com/v1
DMX_API_KEY=
LOGIC_MODEL=gpt-4.1-mini
CODE_MODEL=gpt-4.1-mini

# 可选 TTS：none/silent、openai/dmx、vivo/bluelm
# none 为默认值，不需要 TTS 凭据，生成的视频保留静音轨。
TTS_PROVIDER=none
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-pro
TTS_VOICE=alloy
TTS_SILENT_CHARS_PER_SECOND=4.5
TTS_SILENT_MIN_SECONDS=1.0
TTS_SILENT_MAX_SECONDS=90.0
# 以下字段仅在 TTS_PROVIDER=vivo 时使用
VIVO_TTS_APP_ID=
VIVO_TTS_APP_KEY=
VIVO_TTS_BASE_URL=wss://api-ai.vivo.com.cn
VIVO_TTS_ENGINE_ID=tts_humanoid_lam
# 教学讲解推荐 F245_natural；可选 M193、M24、GAME_GIR_LTY
VIVO_TTS_VOICE=F245_natural
VIVO_TTS_SPEED=50
VIVO_TTS_VOLUME=50

# --------------------------------------------------------------------------
# 端口配置
# --------------------------------------------------------------------------
API_PORT=8080
REDIS_PORT=6379

# --------------------------------------------------------------------------
# 并发配置（留空表示自动检测）
# --------------------------------------------------------------------------
MAX_WORKERS=

# --------------------------------------------------------------------------
# 调试模式（生产环境设为 false）
# --------------------------------------------------------------------------
DEBUG=false
# Native output profile: 1080p30, 4k30, or 4k60. API defaults to 4k30.
K2V_RENDER_WORKERS=1
MANIM_RENDER_TIMEOUT_SECONDS=21600
VIDEO_TASK_TIME_LIMIT_SECONDS=43200
VIDEO_TASK_SOFT_TIME_LIMIT_SECONDS=41400

# Shared /outputs lifecycle (used by the platform worker and bridge)
OUTPUT_SUCCESS_CLEANUP_DELAY_HOURS=6
OUTPUT_FAILED_RETENTION_HOURS=24
OUTPUT_ACTIVE_MARKER_STALE_HOURS=16
OUTPUT_JANITOR_INTERVAL_SECONDS=300
OUTPUT_DISK_WARNING_PERCENT=85
OUTPUT_DISK_MIN_FREE_GB=10
OUTPUT_DISK_ALERT_COOLDOWN_SECONDS=3600
OUTPUT_DISK_ALERT_WEBHOOK_URL=
STORAGE_GC_INTERVAL_SECONDS=3600
STORAGE_GC_RECORD_GRACE_HOURS=24
STORAGE_GC_ORPHAN_GRACE_HOURS=24
