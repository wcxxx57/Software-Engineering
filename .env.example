# ==================== 公网入口 ====================
# 仅填写域名或公网 IP，不包含 http:// 或 https://
PUBLIC_HOST=zhiying.ecnu.top

# ==================== PostgreSQL ====================
POSTGRES_USER=zhiying
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=zhiying_backend

# ==================== RabbitMQ ====================
RABBITMQ_USER=zhiying
RABBITMQ_PASSWORD=please-change-me

# ==================== 后端安全配置 ====================
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TTL_DAYS=30
# 当前敏捷测试只开放课前测试、个性化计划、深度解析、课后小测。
CORE_FLOW_ONLY=false

# 各真实生成能力的回调密钥；必须以 sk- 开头。backend 与对应生成服务
# 必须使用相同值，其中前四项由 core-generation 使用。
KNOWLEDGE_EXPLANATION_API_KEY=sk-change-knowledge-explanation
PRETEST_API_KEY=sk-change-pretest
PLAN_API_KEY=sk-change-plan
CURRICULUM_API_KEY=sk-change-curriculum
QUIZ_API_KEY=sk-change-quiz
INTERACTIVE_HTML_API_KEY=sk-change-interactive-html
KNOWLEDGE_VIDEO_API_KEY=sk-change-knowledge-video
CODE_VIDEO_API_KEY=sk-change-code-video

# ==================== 四个核心消费者的真实模型 ====================
# OpenAI-compatible Chat Completions API；可替换为其他兼容提供方。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.5
# 学习计划大纲可单独指定模型；默认复用 LLM_MODEL。
PLAN_MODEL=gpt-5.5

# ==================== Part 6：AI 伴学（服务端调用本地 vLLM） ====================
# macOS 开发时先建立 SSH 隧道：
# ssh -N -L 8000:127.0.0.1:8000 tyj@100.127.190.81
# Linux Compose 部署时使用 host.docker.internal 访问宿主机 vLLM，且不要将 8000 暴露到公网。
AI_CHAT_BASE_URL=http://127.0.0.1:8000/v1
AI_CHAT_MODEL=cloudops-cloud-assistant
AI_CHAT_API_KEY=
AI_CHAT_TIMEOUT_MS=120000
AI_CHAT_MAX_TOKENS=512
# AI 会优先选择数据库中的已发布课程模板；没有匹配模板时直接生成课程大纲。
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.3
# PRETEST_PROBLEM_COUNT=10
# PRETEST_PROBLEM_COUNT_MIN=6
# PRETEST_PROBLEM_COUNT_MAX=14
# EXPLANATION_TARGET_CHARS=2600
# EXPLANATION_TARGET_CHARS_MIN=1200
# EXPLANATION_TARGET_CHARS_MAX=4800
# EXPLANATION_LENGTH_MAX_ATTEMPTS=2
# QUIZ_PROBLEM_COUNT=5
# PLAN_TASKS_PER_STAGE=3
# WORKER_PREFETCH=2

# ==================== 2D 可视化 ====================
# 默认复用上面的 LLM 配置；需要单独模型时覆盖：
# EDUCATION2D_AGENT_MODEL=gpt-4.1
# EDUCATION2D_AUTHOR_MODEL=gpt-4.1
# EDUCATION2D_AGENT_TIMEOUT_MS=300000
# EDUCATION2D_WORKER_PREFETCH=1

# ==================== 知识视频 ====================
# Knowledge2Video 默认复用上面的 LLM 网关、API Key 和模型；确认网关支持时可取消注释单独覆盖。
KNOWLEDGE_VIDEO_SERVICE_API_KEY=replace-with-random-api-key
# K2V_LOGIC_MODEL=gpt-5.3-codex-spark
# K2V_CODE_MODEL=gpt-5.3-codex-spark
K2V_DEFAULT_API=gpt-5
K2V_RENDER_PROFILE=1080p30
K2V_RENDER_WORKERS=1
K2V_TTS_PROVIDER=vivo
VIVO_TTS_APP_ID=replace-me
VIVO_TTS_APP_KEY=replace-me
VIVO_TTS_BASE_URL=wss://api-ai.vivo.com.cn
VIVO_TTS_ENGINE_ID=tts_humanoid_lam
VIVO_TTS_VOICE=F245_natural
VIVO_TTS_SPEED=50
VIVO_TTS_VOLUME=50
# MANIM_RENDER_TIMEOUT_SECONDS=21600
# VIDEO_TASK_TIME_LIMIT_SECONDS=43200
# VIDEO_TASK_SOFT_TIME_LIMIT_SECONDS=41400

# ==================== 代码题讲解视频 ====================
# Code2Video 保留独立 API，并通过 RabbitMQ bridge 接入后端 code_video 资源。
CODE_VIDEO_SERVICE_API_KEY=replace-with-random-api-key
# 默认复用 LLM_MODEL；确认网关支持时可取消注释单独覆盖。
# CODE_VIDEO_LOGIC_MODEL=gpt-5.3-codex-spark
# CODE_VIDEO_CODE_MODEL=gpt-5.3-codex-spark
CODE_VIDEO_DEFAULT_API=gpt-5
# Code2Video 固定输出 1920x1080/30fps，不提供 4K 渲染。
CODE_VIDEO_RENDER_WORKERS=1
# 每个 Manim 章节的硬超时；超时后会终止完整渲染进程树。
CODE_VIDEO_MANIM_RENDER_TIMEOUT_1080P_SECONDS=1200
CODE_VIDEO_MANIM_RENDER_KILL_GRACE_SECONDS=10
CODE_VIDEO_TTS_PROVIDER=vivo
# CODE_VIDEO_WORKER_PREFETCH=1

# ==================== 对象存储 ====================
STORAGE_ACCESS_KEY=zhiying-storage
STORAGE_SECRET_KEY=please-change-to-a-long-random-secret
STORAGE_REGION=us-east-1
STORAGE_BUCKET=zhiying-content
# 本地填写 http://127.0.0.1:3080/storage；生产填写 https://你的域名/storage
STORAGE_PUBLIC_BASE=https://example.com/storage

# ==================== Video output lifecycle ====================
# Final local copies are removed only after this delay and a successful S3 HEAD check.
OUTPUT_SUCCESS_CLEANUP_DELAY_HOURS=6
# Failed task workspaces remain available for diagnosis until this retention expires.
OUTPUT_FAILED_RETENTION_HOURS=24
# Must be greater than the maximum video task runtime; protects running workspaces.
OUTPUT_ACTIVE_MARKER_STALE_HOURS=16
OUTPUT_JANITOR_INTERVAL_SECONDS=300
OUTPUT_DISK_WARNING_PERCENT=85
OUTPUT_DISK_MIN_FREE_GB=10
OUTPUT_DISK_ALERT_COOLDOWN_SECONDS=3600
# Optional HTTP webhook receiving JSON disk alerts.
OUTPUT_DISK_ALERT_WEBHOOK_URL=

# Database-record and orphan-object garbage collection.
STORAGE_GC_INTERVAL_SECONDS=3600
STORAGE_GC_RECORD_GRACE_HOURS=24
STORAGE_GC_ORPHAN_GRACE_HOURS=24

# ==================== 可选业务参数 ====================
# 本地专项测试可设为 1000；生产应按实际商业规则设置。
# REGISTER_BONUS_DIAMONDS=80
# CHECKIN_REWARD_SEQUENCE=1,2,3,4,6,8,10
# CHECKIN_MAKEUP_GOLD_COST_PER_DAY=50
# CHECKIN_MAKEUP_DIAMOND_COST=1
# CHECKIN_EXP_REWARD=5
# STUDY_TASK_EXP_REWARD=10
# STUDY_QUIZ_EXP_REWARD=15
# STUDY_SUBJECT_EXP_REWARD=200
# STUDY_SUBJECT_COMPLETION_REFUND_PERCENT=50
# KNOWLEDGE_EXPLANATION_GOLD_COST=10
# KNOWLEDGE_VIDEO_DIAMOND_COST=5
# CODE_VIDEO_DIAMOND_COST=5
# INTERACTIVE_HTML_DIAMOND_COST=5
# STUDY_SUBJECT_DIAMOND_COSTS=3:10,7:20,15:40,30:80
# STUDY_QUIZ_FREE_LIMIT_PER_TASK=3
# STUDY_QUIZ_EXTRA_GOLD_COST=20
